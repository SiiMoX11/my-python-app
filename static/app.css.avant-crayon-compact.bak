:root{
  --navy:#0f2d4f; --navy-2:#1d4673; --ink:#13243a; --muted:#5d6f86;
  --bg:#eef3f9; --bg-login:#d9e2f3; --surface:#ffffff; --surface-2:#f4f7fb;
  --line:#c9d6e6; --line-strong:#0f2d4f;
  --head:#dfe7f2; --tab:#dfe7f1; --tab-active:#5b7fae;
  --teal:#5fb8b8; --teal-d:#3f9c9d; --teal-tint:#d3ece9; --corridor:#d6e1ef;
  --danger:#b42c3a; --ok:#2e7d55; --warn:#b7791f;
  --r:14px; --r-sm:9px;
  --shadow:0 2px 8px rgba(15,45,79,.12); --shadow-lg:0 18px 50px rgba(15,45,79,.28);
  --font:'General Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:var(--font);color:var(--ink);background:var(--bg);font-size:15px;line-height:1.4;-webkit-font-smoothing:antialiased}
button{font:inherit;cursor:pointer;color:inherit}
input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.hidden{display:none!important}

/* ---------- Login ---------- */
.login{min-height:100vh;background:var(--bg-login);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;gap:22px}
.login img{width:min(560px,90vw);height:auto}
.login-card{width:min(440px,92vw);background:#f1f5fb;border:3px solid var(--navy);border-radius:28px;overflow:hidden;box-shadow:0 8px 20px rgba(15,45,79,.18)}
.login-card h1{margin:0;background:#bfcce0;text-align:center;font-size:30px;font-weight:700;letter-spacing:.04em;padding:12px 0}
.login-card form{display:flex;flex-direction:column;align-items:center;gap:16px;padding:24px 24px 26px}
.pill{width:min(300px,100%);border:none;background:#fff;border-radius:999px;padding:14px 26px;font-weight:600;font-size:17px;box-shadow:0 3px 6px rgba(0,0,0,.18)}
.pill::placeholder{color:#8a8a8a;letter-spacing:.04em;text-transform:uppercase}
.btn-login{border:none;background:var(--teal);color:#222;font-weight:700;font-size:20px;letter-spacing:.05em;border-radius:999px;padding:11px 32px;box-shadow:0 3px 6px rgba(0,0,0,.2);transition:transform .15s, background .15s}
.btn-login:hover{background:var(--teal-d);transform:translateY(-1px)}
.login-err{color:var(--danger);font-weight:600;min-height:1.2em;font-size:14px;text-align:center}
.login-hint{font-size:13px;color:var(--muted);text-align:center;max-width:440px}

/* ---------- Top bar ---------- */
.topbar{position:sticky;top:0;z-index:20;height:56px;background:#fff;border-bottom:1px solid #dde4ee;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 18px}
.topbar .left,.topbar .right{display:flex;align-items:center;gap:18px}
.topbar .right{justify-content:flex-end}
.topbar h1{margin:0;font-size:24px;font-weight:700;color:#111;white-space:nowrap}
.clock{color:var(--navy-2);font-size:17px;font-variant-numeric:tabular-nums;white-space:nowrap}
.icon-btn{border:none;background:transparent;padding:6px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;color:var(--navy)}
.icon-btn:hover{background:var(--surface-2)}
.username{font-size:17px;color:var(--navy-2);text-transform:uppercase;letter-spacing:.02em}
.search-box{position:relative}
.search-box input{border:1px solid var(--line);border-radius:999px;padding:6px 14px;width:200px;background:var(--surface-2)}
.search-res{position:absolute;right:0;top:110%;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-lg);width:320px;max-height:360px;overflow:auto;z-index:40}
.search-res button{display:block;width:100%;text-align:left;border:none;background:none;padding:9px 14px;border-bottom:1px solid #eef2f7}
.search-res button:hover{background:var(--surface-2)}
.search-res small{color:var(--muted)}

/* Side menu */
.menu-panel{position:fixed;top:56px;left:0;bottom:0;width:270px;background:#fff;box-shadow:var(--shadow-lg);z-index:30;padding:14px;display:flex;flex-direction:column;gap:4px;transform:translateX(-105%);transition:transform .22s ease}
.menu-panel.open{transform:none}
.menu-panel button{text-align:left;border:none;background:none;padding:11px 12px;border-radius:10px;font-weight:600;color:var(--navy)}
.menu-panel button:hover{background:var(--surface-2)}
.menu-panel .sep{height:1px;background:#e5ebf3;margin:8px 0}

/* ---------- Home map ---------- */
.home{min-height:calc(100vh - 56px);overflow-x:auto}
.map{min-width:1100px;height:calc(100vh - 56px);min-height:620px;display:grid;grid-template-rows:1fr 110px 1.25fr;position:relative}
.wing{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 1.5vw;gap:1.5vw}
.wing.top{background:linear-gradient(#f3f6fb,#eef3f9)}
.rooms{display:flex;gap:1.1vw;justify-content:center}
.corridor-h{background:var(--corridor);display:flex;align-items:center;justify-content:space-around;color:#9fb3cb}
.corridor-h svg{width:52px;height:30px}
.bottom{display:grid;grid-template-columns:1fr 96px 1fr;align-items:start;padding:0 1.5vw;gap:1.2vw}
.bottom .rooms{padding-top:36px}
.corridor-v{background:var(--corridor);height:100%;min-height:100%;display:flex;align-items:flex-end;justify-content:center;padding-bottom:70px;color:#9fb3cb}
.corridor-v svg{width:30px;height:52px}
.room{width:clamp(86px,7.1vw,118px);aspect-ratio:1/1;border:2px solid var(--navy);border-radius:16px;background:#f3f5f9;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:18px;color:#111;transition:transform .18s ease, box-shadow .18s ease;position:relative}
.room.occ{background:var(--teal-tint)}
.room:hover{transform:scale(1.08);box-shadow:0 10px 22px rgba(15,45,79,.22);z-index:2}
.room .cross{color:var(--navy-2)}
.room .cnt{position:absolute;bottom:5px;right:8px;font-size:11px;font-weight:700;color:var(--navy-2);opacity:.75}
.room .dots{display:flex;gap:4px}
.room .dots i{width:7px;height:7px;border-radius:50%;background:#c3cfdf}
.room .dots i.on{background:var(--teal-d)}
.hs-table{display:flex;flex-direction:column;align-items:center;gap:8px;border:none;background:none}
.hs-table span{font-size:16px;color:#222}
.hs-table .tbl{width:clamp(170px,13vw,200px);height:78px;border:2px solid var(--navy);border-radius:14px;background:var(--teal);display:flex;align-items:center;justify-content:center;transition:transform .18s, box-shadow .18s;position:relative}
.hs-table:hover .tbl{transform:scale(1.07);box-shadow:0 10px 22px rgba(15,45,79,.22)}
.hs-table .badge{position:absolute;top:-10px;right:-10px;background:var(--navy);color:#fff;border-radius:999px;font-size:12px;font-weight:700;min-width:24px;height:24px;display:flex;align-items:center;justify-content:center;padding:0 6px}
.legend{position:absolute;left:24px;bottom:18px;display:flex;gap:18px;font-size:13px;color:var(--muted);background:rgba(255,255,255,.7);padding:6px 12px;border-radius:10px}
.legend b{display:inline-block;width:14px;height:14px;border:1.5px solid var(--navy);border-radius:4px;vertical-align:-2px;margin-right:6px}

/* ---------- Modal ---------- */
.overlay{position:fixed;inset:0;z-index:50;background:rgba(220,228,240,.35);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:20px;animation:fade .18s ease}
@keyframes fade{from{opacity:0}}
@keyframes pop{from{opacity:0;transform:scale(.96) translateY(8px)}}
.dialog{width:min(980px,96vw);max-height:92vh;background:#f1f5fb;border:2px solid var(--navy);border-radius:22px;box-shadow:var(--shadow-lg);display:flex;flex-direction:column;overflow:hidden;animation:pop .2s ease}
.dialog-head{background:#d6e0f0;padding:20px 26px 14px 60px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.dialog-head h2{margin:0;font-size:32px;font-weight:700;display:flex;align-items:center;gap:12px;color:#0b0b0b}
.dialog-head p{margin:2px 0 0;font-size:18px}
.btn-back{border:none;background:var(--teal);font-weight:700;border-radius:999px;padding:10px 20px;font-size:17px;box-shadow:0 3px 6px rgba(0,0,0,.18);white-space:nowrap;transition:background .15s}
.btn-back:hover{background:var(--teal-d)}
.dialog-body{padding:22px 56px 26px;overflow:auto;display:flex;flex-direction:column;gap:22px}
.bed{display:grid;grid-template-columns:200px 1fr auto;align-items:center;background:#fff;border-radius:20px;box-shadow:0 4px 10px rgba(15,45,79,.15);border:none;text-align:left;padding:0;transition:transform .15s, box-shadow .15s;width:100%}
.bed:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(15,45,79,.2)}
.bed-ico{height:178px;border:2px solid var(--navy);border-radius:20px;background:var(--teal-tint);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#1d62a0;text-align:center;padding:10px}
.bed-ico b{font-size:38px;color:#000;line-height:1}
.bed-ico.loc{font-size:21px;font-weight:700;color:#0b0b0b;line-height:1.25}
.bed-info{padding:0 26px;font-size:19px;line-height:1.6}
.bed-go{padding:0 32px;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:16px;text-align:center;color:#111}
.bed-go .row{display:flex;align-items:center;gap:6px;color:#1d62a0}
.bed.empty .bed-ico{background:#f3f5f9}
.bed.empty .bed-info{color:var(--muted)}

/* Forms in modal */
.form-dialog{width:min(640px,96vw)}
.form-dialog .dialog-head{padding:16px 22px}
.form-dialog .dialog-head h2{font-size:22px}
.form-dialog .dialog-body{padding:20px 22px}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field.full{grid-column:1/-1}
.field label{font-size:13px;font-weight:600;color:var(--navy-2);text-transform:uppercase;letter-spacing:.03em}
.field input,.field select,.field textarea{border:1.5px solid var(--line);border-radius:10px;padding:9px 11px;background:#fff;width:100%}
.field textarea{min-height:110px;resize:vertical;line-height:1.45}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--navy-2);outline:none}
.form-actions{display:flex;justify-content:space-between;gap:10px;margin-top:4px}
.form-actions .r{display:flex;gap:10px;margin-left:auto}
.btn{border:1.5px solid var(--navy);background:#fff;border-radius:999px;padding:8px 18px;font-weight:600}
.btn:hover{background:var(--surface-2)}
.btn.primary{background:var(--navy);color:#fff}
.btn.primary:hover{background:var(--navy-2)}
.btn.teal{background:var(--teal);border-color:var(--teal-d)}
.btn.danger{border-color:var(--danger);color:var(--danger)}
.btn.danger:hover{background:#fbeaec}
.form-err{color:var(--danger);font-weight:600;font-size:14px;min-height:1em}
.seg{display:flex;gap:8px}
.seg label{flex:1;border:1.5px solid var(--line);border-radius:10px;padding:8px;text-align:center;cursor:pointer;font-weight:600;text-transform:none;letter-spacing:0;font-size:14px;color:var(--ink)}
.seg input{display:none}
.seg input:checked+span{color:#fff}
.seg label:has(input:checked){background:var(--navy);border-color:var(--navy);color:#fff}

/* ---------- Patient page ---------- */
.patient{height:calc(100vh - 56px);display:grid;grid-template-rows:auto 1fr;background:var(--bg)}
.tabsbar{display:flex;align-items:center;gap:12px;padding:14px 12px 12px}
.tabs{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;flex:1}
.tab{border:1.5px solid #c8d4e3;background:var(--tab);border-radius:12px;padding:9px 6px;font-weight:600;font-size:18px;letter-spacing:.03em;color:#111;transition:background .15s}
.tab:hover{background:#d2deec}
.tab.active{background:var(--tab-active);border-color:var(--navy);color:#0b1b2e;box-shadow:inset 0 1px 0 rgba(255,255,255,.3)}
.tabsbar .btn-back{display:flex;align-items:center;gap:8px}
.pbody{display:grid;grid-template-columns:270px 1fr;min-height:0;border-top:2px solid var(--navy)}
.consignes{background:#e6edf6;border-right:2px solid var(--navy);display:flex;flex-direction:column;min-height:0}
.col-head{display:flex;align-items:center;justify-content:center;gap:12px;background:var(--head);padding:8px 10px;font-weight:600;font-size:18px;min-height:46px;border-bottom:1px solid var(--line)}
.plus{border:none;background:none;padding:2px;display:inline-flex;color:#000;border-radius:6px}
.plus:hover{background:rgba(15,45,79,.1)}
.cons-list{overflow:auto;flex:1}
.cons{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;font-size:16px;font-weight:500;text-transform:uppercase;border-bottom:1px solid rgba(201,214,230,.6)}
.cons.todo{background:#f1f5fa}
.cons input{appearance:none;-webkit-appearance:none;width:20px;height:20px;flex:none;border:2px solid #222;border-radius:3px;margin:1px 0 0;cursor:pointer;background:#fff;position:relative}
.cons input:checked{background:#111;border-color:#111}
.cons input:checked::after{content:'';position:absolute;left:5px;top:1px;width:6px;height:11px;border:solid #fff;border-width:0 2.5px 2.5px 0;transform:rotate(45deg)}
.cons .txt{flex:1;cursor:pointer;word-break:break-word}
.cons .txt:hover{text-decoration:underline;text-decoration-color:var(--line)}
.cons small{display:block;text-transform:none;color:var(--muted);font-size:11.5px;font-weight:400;margin-top:2px}
.cons-sep{padding:6px 12px;font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.06em;background:#e6edf6}

.main{display:grid;grid-template-rows:auto 1fr;min-width:0;min-height:0}
.idbar{display:grid;grid-template-columns:1fr 150px;border-bottom:2px solid var(--navy);background:#fff}
.idbar .ids{display:flex;align-items:center;justify-content:space-around;gap:16px;padding:12px 18px;font-size:19px;flex-wrap:wrap}
.idbar .ids span{white-space:nowrap}
.idbar .ids .edit{margin-left:4px}
.idbar .roomno{border-left:2px solid var(--navy);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:600;text-align:center;padding:4px}
.status-pill{font-size:12px;font-weight:700;padding:3px 9px;border-radius:999px;background:#fde8e8;color:var(--danger);text-transform:uppercase;letter-spacing:.04em}
.cols{display:grid;grid-template-columns:1fr 1fr 1fr 1.9fr 1.3fr;min-height:0}
.col{display:flex;flex-direction:column;border-right:1.5px solid var(--line);min-height:0;min-width:0;background:#fff}
.col:last-child{border-right:none}
.col-body{overflow:auto;flex:1}
.item{padding:12px 14px;border-bottom:1.5px solid var(--line);font-size:16px;cursor:pointer;position:relative;white-space:pre-wrap;word-break:break-word;transition:background .12s}
.item:hover{background:#f6f9fc}
.item .meta{display:block;font-size:11.5px;color:var(--muted);white-space:normal;margin-top:6px}
.item .k{font-weight:600}
.center{text-align:center}
.motif-block{padding:14px;text-align:center;border-bottom:1.5px solid var(--line);cursor:pointer}
.motif-block .m{font-size:17px;font-weight:600}
.motif-block small{color:var(--muted)}
.atcd-cat{font-size:12px;font-weight:700;letter-spacing:.05em;color:var(--navy-2);text-transform:uppercase;padding:10px 14px 0}
.cat-tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--navy-2);background:var(--head);padding:2px 8px;border-radius:999px;margin-bottom:5px}
.exam .t{font-weight:600;text-align:center;display:block}
.exam .c{text-align:center;display:block}
.exam .tog{display:flex;justify-content:center;border:none;background:none;width:100%;padding:6px 0 0;color:var(--navy)}
.exam .det{margin-top:8px;padding-top:8px;text-align:center}
.exam .det-lbl{display:inline-block;font-size:12px;font-weight:700;background:#e3e6f7;border-radius:5px;padding:2px 8px;margin-bottom:6px;letter-spacing:.04em}
.avis .t{font-weight:600;text-align:center;display:block}
.avis .c{text-align:center;display:block}
.empty{padding:22px 14px;color:var(--muted);font-size:14px;text-align:center}

/* Other tabs */
.panel{overflow:auto;padding:18px 22px;background:#fff;min-height:0}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.panel-head h3{margin:0;font-size:20px}
.timeline{display:flex;flex-direction:column;gap:12px}
.card{border:1.5px solid var(--line);border-radius:14px;padding:14px 16px;background:#fff;cursor:pointer;transition:box-shadow .15s}
.card:hover{box-shadow:var(--shadow)}
.card h4{margin:0 0 6px;font-size:16px}
.card p{margin:0;white-space:pre-wrap}
.card .meta{font-size:12px;color:var(--muted);margin-top:8px}
table.tbl{width:100%;border-collapse:collapse;font-size:15px}
table.tbl th{text-align:left;font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--navy-2);background:var(--head);padding:9px 10px;position:sticky;top:0}
table.tbl td{border-bottom:1px solid #e3eaf3;padding:9px 10px;vertical-align:top}
table.tbl tr.clickable{cursor:pointer}
table.tbl tr.clickable:hover td{background:#f6f9fc}
.chip{display:inline-block;font-size:12px;font-weight:700;padding:2px 9px;border-radius:999px}
.chip.on{background:#e3f4ec;color:var(--ok)}
.chip.off{background:#eef1f5;color:var(--muted)}
.videos{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.videos video,.videos img{width:100%;border-radius:10px;background:#000;max-height:220px;object-fit:contain}
.sortie-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:980px}
.banner{padding:12px 16px;border-radius:12px;background:#fdf3e2;color:#7a4b06;font-weight:600;margin-bottom:14px}
.banner.ok{background:#e3f4ec;color:var(--ok)}

/* Toast */
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--navy);color:#fff;padding:10px 18px;border-radius:999px;font-weight:600;opacity:0;pointer-events:none;transition:all .2s;z-index:100}
#toast.show{opacity:1;transform:translateX(-50%)}
#toast.err{background:var(--danger)}

/* Responsive */
@media (max-width:1100px){
  .cols{grid-template-columns:repeat(5,minmax(240px,1fr));overflow-x:auto}
  .tab{font-size:15px}
}
@media (max-width:820px){
  .topbar{grid-template-columns:auto 1fr auto;padding:0 10px}
  .topbar h1{font-size:17px}
  .clock,.search-box,.username{display:none}
  .patient{height:auto}
  .tabsbar{flex-direction:column;align-items:stretch}
  .tabs{grid-template-columns:repeat(4,1fr)}
  .pbody{grid-template-columns:1fr}
  .consignes{border-right:none;border-bottom:2px solid var(--navy);max-height:340px}
  .idbar{grid-template-columns:1fr 90px}
  .idbar .ids{font-size:15px;justify-content:flex-start}
  .cols{grid-template-columns:1fr;overflow:visible}
  .col{border-right:none;border-bottom:2px solid var(--navy)}
  .col-body{max-height:none}
  .dialog-head{padding:16px}
  .dialog-head h2{font-size:24px}
  .dialog-body{padding:16px}
  .bed{grid-template-columns:110px 1fr}
  .bed-ico{height:120px}
  .bed-go{display:none}
  .bed-info{padding:0 14px;font-size:15px}
  .fgrid,.sortie-grid{grid-template-columns:1fr}
}
@media print{
  .topbar,.tabsbar,.no-print{display:none!important}
  .patient{height:auto}
}

/* MODIFICATION MAJ PAR CRAYON */
.maj-read-only { cursor: default !important; }
.maj-edit-pencil { float: right; display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin: 0 0 4px 6px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; font-size: 21px; line-height: 1; cursor: pointer; }
.maj-edit-pencil:hover { background: #eef2ff; border-color: #64748b; }
.maj-edit-pencil:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
