"""
Chirurgie Viscérale A - CHU Oujda
Plateforme de gestion des patients du service (prototype).

Backend : Python 3 + Flask + SQLite
Lancement local :  python app.py   (http://localhost:8000)
Production       :  gunicorn -w 2 -b 0.0.0.0:8000 app:app
"""
import os
import sqlite3
import secrets
import datetime as dt
from functools import wraps

from flask import Flask, g, jsonify, request, send_from_directory, abort
from werkzeug.security import generate_password_hash, check_password_hash
from werkzeug.utils import secure_filename

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.environ.get("CVA_DB", os.path.join(BASE_DIR, "cva.db"))
UPLOAD_DIR = os.environ.get("CVA_UPLOADS", os.path.join(BASE_DIR, "uploads"))
os.makedirs(UPLOAD_DIR, exist_ok=True)

# Plan du service (vue de haut) : utilisé par le front et pour valider les chambres
ROOMS = [str(n) for n in range(201, 219)]
POSITIONS = ["F", "P"]  # F = côté fenêtre, P = côté porte
MUTUELLES = ["CNSS", "CNOPS", "AMO", "RAMED", "FAR", "Assurance privée", "Payant"]
GROUPES = ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "Inconnu"]
ENTRY_KINDS = {
    "consigne", "atcd", "clinique", "bilan", "examen", "avis",
    "observation", "traitement", "video",
}
KIND_LABEL = {
    "consigne": "Consigne", "atcd": "Antécédent", "clinique": "Clinique",
    "bilan": "Bilan", "examen": "Examen complémentaire", "avis": "Avis spécialisé",
    "observation": "Observation", "traitement": "Traitement", "video": "Vidéo",
}

app = Flask(__name__, static_folder="static", static_url_path="/static")
app.config["MAX_CONTENT_LENGTH"] = 300 * 1024 * 1024  # 300 Mo (vidéos)


# --------------------------------------------------------------------------- DB
def db():
    if "db" not in g:
        g.db = sqlite3.connect(DB_PATH)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys = ON")
    return g.db


@app.teardown_appcontext
def close_db(_exc):
    conn = g.pop("db", None)
    if conn is not None:
        conn.close()


SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    full_name TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'medecin',   -- admin | medecin | infirmier
    password_hash TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 1
);
CREATE TABLE IF NOT EXISTS tokens (
    token TEXT PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS patients (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nom TEXT NOT NULL,
    prenom TEXT NOT NULL DEFAULT '',
    age INTEGER,
    ip TEXT NOT NULL,
    mutuelle TEXT DEFAULT '',
    groupe TEXT DEFAULT '',
    motif TEXT DEFAULT '',
    room TEXT,                 -- 201..218 ou NULL si hors service
    position TEXT,             -- F | P
    hors_service TEXT,         -- ex. 'Service Réanimation Brûlés BOX 2'
    status TEXT NOT NULL DEFAULT 'hospitalise',  -- hospitalise | sorti
    date_entree TEXT,
    sortie_date TEXT, sortie_mode TEXT, sortie_destination TEXT,
    sortie_resume TEXT, sortie_ordonnance TEXT, sortie_rdv TEXT,
    created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    patient_id INTEGER NOT NULL REFERENCES patients(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    category TEXT DEFAULT '',   -- type d'examen, catégorie clinique, spécialité...
    date TEXT DEFAULT '',
    title TEXT DEFAULT '',
    content TEXT DEFAULT '',
    details TEXT DEFAULT '',
    done INTEGER NOT NULL DEFAULT 0,
    author TEXT DEFAULT '',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    patient_id INTEGER,
    user TEXT NOT NULL,
    action TEXT NOT NULL,
    detail TEXT DEFAULT '',
    ts TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_entries_patient ON entries(patient_id, kind);
CREATE INDEX IF NOT EXISTS idx_logs_patient ON logs(patient_id);
"""


def platform_now():
    conn = sqlite3.connect(DB_PATH)
    try:
        minutes = conn.execute("SELECT offset_minutes FROM clock_settings WHERE id=1").fetchone()[0]
    finally:
        conn.close()
    return dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=minutes)


def now():
    return platform_now().strftime("%Y-%m-%d %H:%M:%S")


def init_db(seed=True):
    conn = sqlite3.connect(DB_PATH)
    conn.executescript(SCHEMA)
    columns = {r[1] for r in conn.execute("PRAGMA table_info(users)")}
    if "must_change_password" not in columns:
        conn.execute("ALTER TABLE users ADD COLUMN must_change_password INTEGER NOT NULL DEFAULT 0")
    if "initial_setup_pending" not in columns:
        conn.execute("ALTER TABLE users ADD COLUMN initial_setup_pending INTEGER NOT NULL DEFAULT 0")
        conn.execute("UPDATE users SET initial_setup_pending=must_change_password")
    conn.execute("CREATE TABLE IF NOT EXISTS clock_settings (id INTEGER PRIMARY KEY CHECK(id=1), timezone TEXT NOT NULL DEFAULT 'UTC', offset_minutes INTEGER NOT NULL DEFAULT 0)")
    conn.execute("INSERT OR IGNORE INTO clock_settings VALUES (1, 'UTC', 0)")
    conn.execute("CREATE TABLE IF NOT EXISTS app_migrations (name TEXT PRIMARY KEY)")
    if not conn.execute("SELECT 1 FROM app_migrations WHERE name='utc_default_v2'").fetchone():
        conn.execute("UPDATE clock_settings SET timezone='UTC', offset_minutes=0 WHERE id=1")
        conn.execute("INSERT INTO app_migrations VALUES ('utc_default_v2')")
    conn.execute("UPDATE users SET active=1 WHERE role='admin'")
    conn.execute("UPDATE users SET must_change_password=initial_setup_pending")
    conn.commit()
    if seed and conn.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        _seed(conn)
    conn.commit()
    conn.close()


