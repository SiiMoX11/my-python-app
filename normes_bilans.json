      "max_exclusive": false
    },
    "Creat": {
      "unit": "mg/L",
      "min": 5.543,
      "max": 11.7647,
      "source": "Oxford",
      "note": "Sexe absent : enveloppe F 49–90 et M 64–104 µmol/L. Seules anomalies certaines pour les deux sexes signalées ; conversion mg/L = µmol/L / 8,84.",
      "max_exclusive": false
    },
    "Na": {
      "unit": "mmol/L",
      "min": 136,
      "max": 146,
