{
  "version": "adultes-indicatif-v2",
  "status": "Références documentées indicatives, non validées par le laboratoire du service",
  "enabled": true,
  "minimum_age": 19,
  "warning": "Les unités proposées correspondent à la convention de saisie choisie, pas à une norme nationale marocaine. Validation locale nécessaire. Hors référence ne signifie pas diagnostic ; absence de rouge ne garantit pas normalité.",
  "sources": {
    "Oxford": "https://www.ouh.nhs.uk/media/22pfm4ac/biochemistry-reference-ranges.pdf",
    "SPS": "https://sps.nhs.uk/articles/assessing-liver-function-and-interpreting-liver-blood-tests/",
    "CMC": "https://mcc.ca/fr/examens-et-evaluations/ressources-pour-aider-a-la-preparation-dun-examen/valeurs-de-reference/",
    "IFSI": "https://reussistonifsi.fr/guide-infirmier-normes-biologiques/"
  },
  "parameters": {
    "Alb": {
      "unit": "g/L",
      "min": 35,
      "max": 50,
      "source": "SPS",
      "note": "",
      "max_exclusive": false
    },
    "GB": {
      "unit": "/mm³",
      "min": 4000,
      "max": 10000,
      "source": "IFSI",
      "note": "",
      "max_exclusive": false
    },
    "Hb": {
      "unit": "g/dL",
      "min": 11.5,
      "max": 17,
      "source": "CMC",
      "note": "Sexe absent du dossier : enveloppe des intervalles F 11,5–15,5 et M 12,5–17. Seules les anomalies certaines pour les deux sexes sont signalées. Une valeur non rouge ne garantit pas la normalité.",
      "max_exclusive": false
    },
    "Plq": {
      "unit": "/mm³",
      "min": 150000,
      "max": 400000,
      "source": "IFSI",
      "note": "Entrer 196000 ou 196k, jamais 196 seul pour 196000.",
      "max_exclusive": false
    },
    "TP": {
      "unit": "%",
      "min": 70,
      "max": null,
      "source": "IFSI",
      "note": "Seuil indicatif de référence, non une cible sous anticoagulants.",
      "max_exclusive": false
    },
    "CRP": {
      "unit": "mg/L",
      "min": 0,
      "max": 5,
      "source": "Oxford",
      "note": "",
      "max_exclusive": false
    },
    "Lipase": {
      "unit": "UI/L",
      "min": 8,
      "max": 78,
      "source": "Oxford",
      "note": "Limite liée à une méthode, à valider localement avant usage clinique.",
      "max_exclusive": false
    },
    "BT": {
      "unit": "mg/L",
      "min": 0,
      "max": 12.2771,
      "source": "Oxford",
      "note": "Converti depuis 0–21 µmol/L : mg/L = µmol/L / 1,7105.",
      "max_exclusive": false
    },
    "BD": {
      "unit": "mg/L",
      "min": 0,
      "max": 2.9231,
      "source": "Oxford",
      "note": "Converti depuis 0–5 µmol/L.",
      "max_exclusive": false
    },
    "GGT": {
      "unit": "UI/L",
      "min": 0,
      "max": 50,
      "source": "SPS",
      "note": "Exemple générique adulte.",
      "max_exclusive": false
    },
    "PAL": {
      "unit": "UI/L",
      "min": 30,
      "max": 130,
      "source": "Oxford",
      "note": "Adulte >18 ans.",
      "max_exclusive": false
    },
    "ASAT": {
      "unit": "UI/L",
      "min": 0,
      "max": 40,
      "source": "SPS",
      "note": "",
      "max_exclusive": false
