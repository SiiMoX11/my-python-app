    "ALAT": {
      "unit": "UI/L",
      "min": 0,
      "max": 40,
      "source": "SPS",
      "note": "",
      "max_exclusive": false
    },
    "Uree": {
      "unit": "g/L",
      "min": 0.1502,
      "max": 0.4685,
      "source": "Oxford",
